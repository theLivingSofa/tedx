# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# With NO Google and NO Cashfree values the site runs in demo mode: local JSON storage + mock payments.

# Canonical public origin, e.g. https://merch.example.com (no trailing slash). Required in production
# (CORS allow-list + Cashfree return/notify URLs). Leave empty locally: the request host is used.
SITE_URL=

# --- Google Sheets storage (all three needed; otherwise local-file storage is used) ---
# Spreadsheet ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Service account email; share the sheet with it as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account PEM key in double quotes, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# --- Cashfree Payment Gateway (both needed for real payments; otherwise mock mode) ---
# App ID from the Cashfree dashboard (sent as x-client-id).
CASHFREE_APP_ID=
# Secret key (sent as x-client-secret; also the webhook HMAC key). Server-side only.
CASHFREE_SECRET_KEY=
# sandbox or production.
CASHFREE_ENV=sandbox
# x-api-version header sent to Cashfree.
CASHFREE_API_VERSION=2026-01-01
# Leave empty for auto (cashfree when keys are set, else mock); "mock" forces mock; "cashfree" requires keys.
PAYMENT_MODE=
# Mock mode is refused on VERCEL_ENV=production unless this is true (demo deployments only).
ALLOW_MOCK_IN_PRODUCTION=false
# Mock mode is also refused while Google Sheets is configured (so simulated payments never land in the real
# Orders tab, e.g. from a preview deployment) unless this is true. Mock orders are flagged TEST_PAYMENT_MOCK.
ALLOW_MOCK_WITH_SHEETS=false

# --- Store behaviour ---
# Rupees charged per printed item (the Config sheet tab overrides this).
PRINTING_CHARGE=0
# Minutes before an unpaid Cashfree order expires (minimum 16).
ORDER_EXPIRY_MINUTES=30
# Reconcile only orders older than this many minutes.
RECONCILE_MIN_AGE_MINUTES=10
# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (long random string, e.g. openssl rand -hex 32).
CRON_SECRET=
# Password for the organiser dashboard at /admin (at least 12 characters). Leave empty to switch /admin off.
ADMIN_PASSWORD=
# Max allowed clock skew (seconds) for Cashfree webhook timestamps.
WEBHOOK_TOLERANCE_SECONDS=300

# --- Optional receipt email via Resend (sent only when both are set) ---
# Resend API key.
RESEND_API_KEY=
# Verified sender, e.g. TEDxIIMRohtak Merch <merch@yourdomain>
EMAIL_FROM=

# --- Local / infrastructure ---
# Folder for local JSON storage when Google Sheets is not configured (default: <os tmpdir>/tedx-merch).
LOCAL_DATA_DIR=
# Read the client IP from x-forwarded-for (true on Vercel). Set false when not behind a trusted proxy.
TRUST_PROXY=true
# Port for `npm run dev` (default 3000).
PORT=3000
